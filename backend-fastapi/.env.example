# ---------------------------------------------------------------------------
# Same Supabase Postgres the Shopify app (../frontend) writes pending installs
# into. Use the session pooler URI (port 5432) - this service issues normal
# parameterized queries so the transaction pooler is fine too, but session
# keeps it consistent with the frontend's OMS_DATABASE_URL.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase project settings > API > JWT Settings > Legacy JWT Secret.
# Used to verify the same access token the OMS frontend already holds after
# Supabase Auth login (HS256). If this project has migrated to the newer
# asymmetric JWT signing keys, this service needs updating to verify against
# the JWKS endpoint instead - see app/auth.py.
SUPABASE_JWT_SECRET=

# Same client_id/client_secret as ../frontend's SHOPIFY_API_KEY/SHOPIFY_API_SECRET
# (Partner/dev dashboard > app > API credentials). Only used by
# refresh_access_token (scripts/refresh_tokens.py) - that call authenticates
# as the app itself, not with any one merchant's token.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Shopify Admin API version to call when verifying a token / registering
# webhooks. Keep in sync with [webhooks].api_version in ../frontend/shopify.app.toml.
SHOPIFY_API_VERSION=2026-10

# Publicly reachable base URL for *this* FastAPI service (no trailing slash).
# Shopify calls back to {PUBLIC_BACKEND_URL}/webhooks/shopify/orders once a
# webhook subscription is registered - during local testing this needs to be
# a tunnel URL (e.g. ngrok/cloudflared), not localhost.
PUBLIC_BACKEND_URL=http://localhost:8000

# Comma-separated origins allowed to call this API from a browser (the OMS
# frontend's own URL(s)). Leave blank to allow none.
CORS_ORIGINS=http://localhost:3000
