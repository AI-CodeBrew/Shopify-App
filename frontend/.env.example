# ---------------------------------------------------------------------------
# Shopify app credentials (Partner Dashboard > Apps > Connector > API creds)
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=
# The shpss_... shared secret. This doubles as the HMAC key Shopify signs
# webhooks with, so it is exactly the value the OMS stores as `webhook_secret`.
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://connector.fynktech.com

# Must stay byte-identical to [access_scopes].scopes in shopify.app.toml.
# Regenerate with: npm run scopes:sync
SCOPES=read_all_orders,read_assigned_fulfillment_orders,read_customers,read_discounts,read_draft_orders,read_files,read_fulfillments,read_inventory,read_locations,read_merchant_managed_fulfillment_orders,read_order_edits,read_orders,read_price_rules,read_products,read_returns,read_shipping,read_shopify_payments_disputes,read_shopify_payments_payouts,read_third_party_fulfillment_orders,write_assigned_fulfillment_orders,write_customers,write_draft_orders,write_files,write_fulfillments,write_inventory,write_merchant_managed_fulfillment_orders,write_order_edits,write_orders,write_products,write_returns,write_shipping,write_third_party_fulfillment_orders

# ---------------------------------------------------------------------------
# FynkTech OMS - the Supabase Postgres this app writes credentials into.
# ---------------------------------------------------------------------------
# Same value as DATABASE_URL in OMS backend/.env.backend. Use the Supabase
# *session pooler* URI (port 5432), not the transaction pooler - this app runs
# prepared statements that the transaction pooler rejects.
OMS_DATABASE_URL=

# Where the merchant is sent to finish the connection. No trailing slash.
OMS_APP_URL=https://app.fynktech.com

# Set to 1 ONLY on first deploy, to let `npm run oms:bootstrap` create the
# integrations.shopify_pending_installs table. Leave unset afterwards.
OMS_ALLOW_BOOTSTRAP=

# App's own session store (Prisma). Must be Postgres - Vercel's serverless
# filesystem can't persist SQLite. Reuse the OMS Supabase project with a
# dedicated schema, e.g. same URL as OMS_DATABASE_URL plus `?schema=shopify_sessions`.
DATABASE_URL=
