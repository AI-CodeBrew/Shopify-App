# ---------------------------------------------------------------------------
# Shopify app credentials (Partner Dashboard > Apps > FynkTech AI > API creds)
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=
# The shpss_... shared secret. This doubles as the HMAC key Shopify signs
# webhooks with, so it is exactly the value the OMS stores as `webhook_secret`.
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://REPLACE-ME.example.com

# Must stay byte-identical to [access_scopes].scopes in shopify.app.toml.
# Regenerate with: npm run scopes:sync
SCOPES=read_orders,write_orders,read_all_orders,read_draft_orders,write_draft_orders,read_order_edits,write_order_edits,read_fulfillments,write_fulfillments,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders,write_third_party_fulfillment_orders,read_inventory,write_inventory,read_locations,read_returns,write_returns,read_products,write_products,read_customers,write_customers,read_shipping,write_shipping,read_price_rules,read_discounts,read_shopify_payments_payouts,read_shopify_payments_disputes

# ---------------------------------------------------------------------------
# FynkTech OMS - the Supabase Postgres this app writes credentials into.
# ---------------------------------------------------------------------------
# Same value as DATABASE_URL in OMS backend/.env.backend. Use the Supabase
# *session pooler* URI (port 5432), not the transaction pooler - this app runs
# prepared statements that the transaction pooler rejects.
OMS_DATABASE_URL=

# Where the merchant is sent to finish the connection. No trailing slash.
OMS_APP_URL=https://app.fynktech.com

# Set to 1 ONLY on first deploy, to let `npm run oms:bootstrap` create the
# integrations.shopify_pending_installs table. Leave unset afterwards.
OMS_ALLOW_BOOTSTRAP=

# App's own session store (Prisma). SQLite by default; use Postgres in prod.
DATABASE_URL=file:dev.sqlite
